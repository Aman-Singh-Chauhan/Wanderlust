<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center">
  <div class="col-lg-10">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body p-4">
        <h2 class="mb-2">@<%= profileUser.username %></h2>
        <p class="text-muted mb-0">Listings created by this host</p>
      </div>
    </div>

    <% if (listings && listings.length > 0) { %>
      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
        <% for (let listing of listings) { %>
          <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-link">
              <div class="card listing-card h-100">
                <img src="<%= listing.image && listing.image.url ? listing.image.url : '/images/default-listing.jpg' %>" class="card-img-top" alt="listing image" style="height: 20rem; object-fit: cover;" />
                <div class="card-body">
                  <h5 class="card-title"><%= listing.title %></h5>
                  <p class="card-text mb-0">
                    ₹<%= listing.price?.toLocaleString("en-IN") %>/night
                  </p>
                </div>
              </div>
            </a>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="alert alert-secondary">No listings yet.</div>
    <% } %>
  </div>
</div>
