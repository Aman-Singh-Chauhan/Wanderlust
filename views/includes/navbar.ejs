<style>
  .search-btn{
    background-color: #fe424d;
    color:#fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
    white-space: nowrap;
  }
  .search-btn:hover{
    background-color: #fe424d;
    color:#fff;
  }
  .search-btn i {
    
    margin-right: 0.5rem;
  }

  .search-inp{
    border-radius: 25px;
    padding:0.5rem 3rem 0.5rem 3rem;
    font-size: 1rem;
  }
</style>


<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" type="button"
     data-bs-toggle="collapse" 
     data-bs-target="#navbarNavAltMarkup" 
     >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        
        <a class="nav-link" href="/listings">Explore</a>
     
      </div>
       
      <div class="navbar-nav ms-auto">
          
      <form class="d-flex" role="search" action="/listings/search" method="GET" id="navbar-search-form">
      <input class="form-control me-2 search-inp" 
      type="search" 
      name="q"
      id="navbar-search-input"
      placeholder="Search destination" 
      value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
      />
      <button class="btn search-btn" type="submit"> 
      <i class="fa-solid fa-magnifying-glass"></i>
        Search</button>
    </form>
      </div>

      
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <% if (!isAuthenticated) { %>
        <a class="nav-link"  href="/signup"> <b>Sign up</b></a>
        <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>
        <% if (isAuthenticated) { %>
        <!--<a class="nav-link" href="/<%= currUser.username %>">Profile</a>-->
        <a class="nav-link" href="/logout"><b>Log out</b></a>
     <% } %>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('navbar-search-form');
    const input = document.getElementById('navbar-search-input');

    if (!form || !input) return;

    let debounceTimer;

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const query = input.value.trim();
        const listingsContainer = document.getElementById('listings-grid');

        if (!listingsContainer) return;

        fetch(`/listings/search?q=${encodeURIComponent(query)}`)
          .then((res) => res.json())
          .then((listings) => {
            listingsContainer.innerHTML = '';

            if (!listings.length) {
              listingsContainer.innerHTML = '<div class="col-12"><div class="alert alert-secondary">No listings found.</div></div>';
              return;
            }

            listings.forEach((listing) => {
              const card = document.createElement('div');
              card.className = 'col';

              const imageUrl = listing.image && listing.image.url ? listing.image.url : '/assets/beach.webp';
              card.innerHTML = `
                <a href="/listings/${listing._id}" class="listing-link">
                  <div class="card listing-card h-100">
                    <img src="${imageUrl}" class="card-img-top" alt="listing image" style="height: 20rem; object-fit: cover;" />
                    <div class="card-body">
                      <p class="card-text">
                        <b>${listing.title}</b><br/>
                        ₹${Number(listing.price || 0).toLocaleString('en-IN')}/night
                      </p>
                    </div>
                  </div>
                </a>
              `;
              listingsContainer.appendChild(card);
            });

            input.focus();
          })
          .catch((err) => {
            console.error('Search failed', err);
            listingsContainer.innerHTML = '<div class="col-12"><div class="alert alert-danger">Unable to load results.</div></div>';
          });
      }, 400);
    });
  });
</script>